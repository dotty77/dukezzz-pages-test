onds":20,"trigger":"actual-squad-anomaly-crit","refresh":"reset-duration","scope":"self-fire-damage","refinements":{"anomalyProficiency":[90,99,108,117,126],"fireDamagePercent":[40,44,48,52,56]},"sourceRefs":["14164-r1","14164-r2","14164-r3","14164-r4","14164-r5"]},{"id":"c-signature","agentId":"1561","engineId":"14156","durationSeconds":40,"trigger":"separate-ex-use-deals-wind-damage","maxStacks":2,"maxTriggersPerSkillUse":1,"teamBonusRequiresStacks":2,"refresh":"reset-duration","refinements":{"ownAnomalyProficiency":[70,80,90,100,110],"ownVortexWindsweptPercentPerStack":[7,8,9,10,11],"teamAnomalyProficiencyAtTwoStacks":[60,69,78,87,96]},"sourceRefs":["14156-r1","14156-r2","14156-r3","14156-r4","14156-r5"]},{"id":"c-cyclone-duration","agentId":"1561","durationSeconds":5,"tickIntervalSeconds":0.5,"maxConcurrent":1,"sourceRefs":["156100005","1561-core-13"]},{"id":"c-cyclone-buildup-res","agentId":"1561","durationSeconds":35,"valuePercentWithAdditionalAbility":14,"trigger":"sweeping-cyclone-hit","refresh":"reset-duration","scope":"wind-and-tinted-attribute-when-applicable","sourceRefs":["1561-core-13","1561-core-14"]},{"id":"a-stun-extension","agentId":"1581","extensionSeconds":3,"trigger":"flower-feather-hit-stunned-enemy","maxPerTargetPerStun":1,"stacksWithSimilarEffects":false,"sourceRefs":["158100017"]}],"mechanicsConfigRules":[{"id":"1581-m1","agentId":"1581","cinemaMin":1,"impact":"opening-action","note":"开局3特殊虚曜，解锁开局兑现步骤；花羽轮舞200喧响有18秒间隔。","noteEn":"Upon entering the battlefield, Remielle gains 3 special Voidflares. In Investigation Zone mode, this effect can trigger once every 180s. When Remielle triggers Luminize to deal DMG, she ignores 50% of the target's All-Attribute RES. When using Assist: Flower & Feather Dance, she gains 200 Decibels. This effect can trigger once every 18s. While Remielle is in the Phase Flow state, other squad members' Attribute Anomaly DMG increases by 10%.","stepIds":["a-opening-spend"],"sourceRefs":["1581-m1"]},{"id":"1581-m2","agentId":"1581","cinemaMin":2,"impact":"background-frequency","note":"异化系数+20%，幻色下异常伤害无视15%防御，后台布点频率提高但具体间隔缺失。","noteEn":"Remielle's Refringe Coefficient increases by 20%. When an Anomaly character in the squad deals Anomaly DMG to an enemy affected by Prismatic, the attack ignores 15% of the target's DEF. This effect persists for an additional 8s after Prismatic ends. While Remielle is in the Phase Flow state, the frequency at which she automatically attacks to apply Lumiflux Buildup to enemies increases.","stepIds":[],"sourceRefs":["1581-m2"]},{"id":"1581-m3","agentId":"1581","cinemaMin":3,"impact":"skill-level","note":"五类技能等级+2，改变倍率，不单独增加动作。","noteEn":"Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2","stepIds":[],"sourceRefs":["1581-m3"]},{"id":"1581-m4","agentId":"1581","cinemaMin":4,"impact":"opening-action","note":"开局特殊虚曜首次消耗后补满一次；进相变即取消待补，增加第二次开局兑现。","noteEn":"When Remielle triggers Luminize, the DMG multiplier is increased by an additional 12%. After entering the battlefield and gaining 3 special Voidflares, if all Voidflares are consumed, she immediately gains the maximum number of special Voidflares again. This effect to regain special Voidflares is removed after being triggered once or when Remielle enters the Phase Flow state.","stepIds":["a-opening-refill"],"sourceRefs":["1581-m4"]},{"id":"1581-m5","agentId":"1581","cinemaMin":5,"impact":"skill-level","note":"五类技能等级再+2，改变倍率，不单独增加动作。","noteEn":"Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2","stepIds":[],"sourceRefs":["1581-m5"]},{"id":"1581-m6","agentId":"1581","cinemaMin":6,"impact":"loop-action","note":"垂虹/惊鸿耀变两次；普攻四段命中生3个开局25%强度的特殊虚曜，增加前场自供分支。","noteEn":"When Remielle uses Basic Attack: Rainbow's End or Basic Attack: Fleeting Grace, Luminize is triggered 2 times. If the 4th hit of her Basic Attack lands against a target, Remielle gains 3 special Voidflares after the skill ends. Special Voidflares gained this way deal DMG equal to 25% of the special Voidflares gained upon entering the battlefield.","stepIds":["a-m6-self-cycle"],"sourceRefs":["1581-m6"]},{"id":"1641-m1","agentId":"1641","cinemaMin":1,"impact":"initial-resource","note":"开局1升变、燔焰获取效率+15%；可从燎斩接普攻三四段，不固定达到90的轮数。","noteEn":"Upon entering the battlefield, Phoenix gains 1 point of Ascension. In Investigation Zone mode, this effect can trigger once every 180s.\nThe CRIT DMG of Anomaly DMG dealt to enemies in the Sear state is increased by an additional 25%.\nWhen a Combustion Attack deals DMG, Pyre generation efficiency increases by 15%.","stepIds":["b-resource-loop"],"sourceRefs":["1641-m1"]},{"id":"1641-m2","agentId":"1641","cinemaMin":2,"impact":"effect-only","note":"本人灼烧持续+2秒，对灼蚀目标增伤30%；不凭影画2新增固定攻击步骤。","noteEn":"When Phoenix applies Burn to an enemy, its duration is increased by 2s.\nPhoenix's DMG against enemies in the Sear state increases by 30%.","stepIds":[],"sourceRefs":["1641-m2"]},{"id":"1641-m3","agentId":"1641","cinemaMin":3,"impact":"skill-level","note":"五类技能等级+2。","noteEn":"Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2","stepIds":[],"sourceRefs":["1641-m3"]},{"id":"1641-m4","agentId":"1641","cinemaMin":4,"impact":"conditional-cashout","note":"焚罪/烬火终结一击命中异常目标时额外一次600%异放；保持异常覆盖提醒。","noteEn":"When the Finishing Move of Soul-Searching Blaze or Basic Attack: Purifying Flame hits an enemy affected by an Attribute Anomaly, it triggers 1 additional instance of Abloom, resolving the corresponding Attribute Anomaly DMG at a fixed 600% multiplier.","stepIds":["b-anomaly-cashout","b-ultimate-return"],"sourceRefs":["1641-m4"]},{"id":"1641-m5","agentId":"1641","cinemaMin":5,"impact":"skill-level","note":"五类技能等级再+2。","noteEn":"Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2","stepIds":[],"sourceRefs":["1641-m5"]},{"id":"1641-m6","agentId":"1641","cinemaMin":6,"impact":"resource-loop","note":"眩焰也给1升变；升变上限1，消耗分支需按当前资源选，不能固定等坠阳才获得。","noteEn":"Phoenix ignores 15% of the targets' All-Attribute RES.\nWhen Phoenix uses EX Special Attack: Dazzling Flare, she gains 1 point of Ascension.\nAbloom effects triggered by Phoenix ignore 40% of enemy DEF.","stepIds":["b-resource-loop"],"sourceRefs":["1641-m6"]},{"id":"1561-m1","agentId":"1561","cinemaMin":1,"impact":"effect-only","note":"提升广域气旋失衡和相关抗性忽略，不建立固定击破循环。","noteEn":"Sweeping Cyclone from Additional Ability: Tea Party Etiquette deals an additional 20% Daze. When Velina triggers Vortex, she ignores 20% of the target's All-Attribute RES. When squad members deal Windswept DMG, 20% of the target's Wind RES is ignored.","stepIds":[],"sourceRefs":["1561-m1"]},{"id":"1561-m2","agentId":"1561","cinemaMin":2,"impact":"resource-loop","note":"风化每5秒至多给1风蚀；赋彩气旋可积对应属性且这部分积蓄不参与异常伤害结算。","noteEn":"When Velina triggers Windswept, she can also gain 1 point of Windbite. This effect can trigger once every 5s. After Sweeping Cyclone triggers the Chromatic Tint effect, it can accumulate the corresponding attribute's Anomaly Buildup. The buildup accumulated by this attack is excluded from Anomaly DMG calculations. The DMG increase effects of Velina's Windswept and Vortex from Additional Ability: Tea Party Etiquette are further increased by 15%.","stepIds":["c-cyclone-handoff"],"sourceRefs":["1561-m2"]},{"id":"1561-m3","agentId":"1561","cinemaMin":3,"impact":"skill-level","note":"五类技能等级+2。","noteEn":"Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2","stepIds":[],"sourceRefs":["1561-m3"]},{"id":"1561-m4","agentId":"1561","cinemaMin":4,"impact":"buff-window","note":"发动EX使自身攻击+15%，40秒，重复刷新。","noteEn":"When Velina uses an EX Special Attack, her ATK increases by 15% for 40s. Repeated triggers reset the duration.","stepIds":[],"sourceRefs":["1561-m4"]},{"id":"1561-m5","agentId":"1561","cinemaMin":5,"impact":"skill-level","note":"五类技能等级再+2。","noteEn":"Basic Attack, Dodge, Assist, Special Attack, and Chain Attack Lv. +2","stepIds":[],"sourceRefs":["1561-m5"]},{"id":"1561-m6","agentId":"1561","cinemaMin":6,"impact":"resource-loop","note":"消耗2风蚀时返1点有6秒间隔；已有风化可按剩余时间增强再施加伤害，不凭空计算剩余秒数。","noteEn":"When Velina consumes 2 points of Windbite to increase the DMG Multiplier of Vortex, she gains 1 point of Windbite. This effect can trigger once every 6s. When Velina hits an enemy suffering a Wind Attribute Anomaly, the Wind Attribute Anomaly Buildup she inflicts increases by 20%. When Velina inflicts Windswept on an enemy already affected by Windswept, the new Windswept's DMG increases based on the remaining duration of the previous. Each remaining second increases the DMG by 2.5%, up to a maximum increase of 40%.","stepIds":[],"sourceRefs":["1561-m6"]}],"mechanicsReferencePointers":{"156100001":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/0","title":"普通攻击：扇舞","titleEn":"Basic Attack: Dancing Fans"},"156100002":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/1","title":"特殊技：风切变·激浊","titleEn":"Special Attack: Wind Shear - Purging Surge"},"156100003":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/2","title":"强化特殊技：风切变·扬清","titleEn":"EX Special Attack: Wind Shear - Purifying Rise"},"156100004":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/3","title":"强化特殊技：风切变·三重绝息","titleEn":"EX Special Attack: Wind Shear - Triple Deathblow"},"156100005":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/4","title":"强化特殊技：风切变·风暴眼","titleEn":"EX Special Attack: Wind Shear - Eye of the Storm"},"156100006":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/5","title":"闪避：拂岚","titleEn":"Dodge: Windward Sweep"},"156100007":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/6","title":"冲刺攻击：踏风","titleEn":"Dash Attack: Gale Step"},"156100008":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/7","title":"闪避反击：折云","titleEn":"Dodge Counter: Cloudrend"},"156100009":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/8","title":"连携技：旋舞华章","titleEn":"Chain Attack: Thousandfold Spiral"},"156100010":{"sourceId":"1561","jsonPointer":"/agents/1561/skills/9","title":"终结技：聆听呼啸","titleEn":"Ultimate: Heed the Tempest"},"15